# Exemple de configuration — copier vers ~/.pi-harness.env puis `source`
# ⚠️ À NE JAMAIS committer. Seules des variables d'environnement, aucun secret dans le repo.

export MISTRAL_API_KEY="votre-clé-mistral"

# Optionnel :
export HARNESS_MODEL="mistral-small-latest"
export HARNESS_SUMMARY_MODEL="open-mistral-nemo"
export HARNESS_MAX_TOOL_CALLS="15"
# export HARNESS_ALLOWED_COMMANDS="ls,cat,systemctl status,docker ps"
# export TELEGRAM_BOT_TOKEN="…"
# export TELEGRAM_CHAT_ID="…"
